{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Hashed build output never changes; everything else (index.html, sw.js, manifest) must revalidate
	# so a new deploy reaches installed PWAs.
	@immutable path /_expo/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@mutable not path /_expo/static/*
	header @mutable Cache-Control "no-cache"

	# Single-page app: unknown paths load the app shell and Expo Router takes over.
	try_files {path} /index.html
	file_server
}
