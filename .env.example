# Copy to .env (next to docker-compose.yml) and fill in real values.
# Docker Compose reads .env automatically. Never commit .env.

# Required. 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Recommended. Postgres password; defaults to "carreras" when unset.
POSTGRES_PASSWORD=

# Optional. Admin panel master password at /admin (12+ characters).
# Leave empty to disable the panel entirely.
ADMIN_PASSWORD=
